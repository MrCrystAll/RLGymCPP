@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

message(STATUS "Checking for dependencies...")

if(TARGET RLGym::API)
    message(STATUS "RLGymAPI v${RLGymAPI_VERSION} found.")
else()
    message(FATAL_ERROR "RLGymAPI not found, can't continue.")
endif()

if(NOT TARGET Eigen3::Eigen)
    find_package(Eigen3 CONFIG REQUIRED)
endif()

if(NOT TARGET nlohmann_json::nlohmann_json)
    find_package(nlohmann_json CONFIG REQUIRED)
endif()

if(NOT TARGET RocketSim::RocketSim)
    find_package(RocketSim CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RLGymRLTargets.cmake")
check_required_components(RLGymRocketLeague)

if (NOT TARGET RLGym::RocketLeague)
  add_library(RLGym::RocketLeague ALIAS RLGymRocketLeague)
endif()