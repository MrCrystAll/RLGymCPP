@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

message(STATUS "Checking for dependencies...")

find_dependency(RLGymAPI CONFIG REQUIRED)
if(RLGymAPI_FOUND)
    message(STATUS "RLGymAPI v${RLGymAPI_VERSION} found.")
else()
    message(FATAL_ERROR "RLGymAPI not found, can't continue.")
endif()

find_dependency(Eigen3 CONFIG REQUIRED)
if(Eigen3_FOUND)
    message(STATUS "Eigen3 v${Eigen3_VERSION} found.")
else()
    message(FATAL_ERROR "Eigen3 not found, can't continue.")
endif()

find_dependency(nlohmann_json CONFIG REQUIRED)
if(nlohmann_json_FOUND)
    message(STATUS "nlohmann_json v${nlohmann_json_VERSION} found.")
else()
    message(FATAL_ERROR "nlohmann_json not found, can't continue.")
endif()

find_dependency(RocketSim CONFIG REQUIRED)
if(RocketSim_FOUND)
    message(STATUS "RocketSim v${RocketSim_VERSION} found.")
else()
    message(FATAL_ERROR "RocketSim not found, can't continue.")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RLGymRLTargets.cmake")
check_required_components(RLGymRocketLeague)

if (NOT TARGET RLGym::RocketLeague)
  add_library(RLGym::RocketLeague ALIAS RLGymRocketLeague)
endif()